<article class="project-card min-w-0">
  {% if project.detailsUrl %}
    <a class="block" href="{{ project.detailsUrl | url }}">
  {% endif %}
  {% if project.image %}
    <div class="{{ project.artClass }} relative mb-4 grid aspect-[3/2] place-items-center overflow-hidden">
      <img
        class="max-h-full max-w-full object-contain{% if project.imageMode == 'phone' %} phone-shot{% endif %}"
        src="{{ project.image | url }}"
        alt="{{ project.imageAlt }}"
        width="{{ project.imageWidth }}"
        height="{{ project.imageHeight }}"
        loading="lazy"
      />
      <span class="art-index absolute left-2 top-2 grid size-8 place-items-center rounded-full" aria-hidden="true">{{ project.number }}</span>
    </div>
  {% else %}
    <div class="project-art {{ project.artClass }}" aria-hidden="true"></div>
  {% endif %}
  {% if project.detailsUrl %}
    </a>
  {% endif %}
  <div class="project-meta mb-2 flex justify-between gap-2">
    <span>{{ project.category }}</span><span>{{ project.status }}</span>
  </div>
  <div class="mb-2 flex items-baseline justify-between gap-2">
    <h3 class="m-0 min-w-0">
      {{ project.title }}
    </h3>
    {% if project.detailsUrl %}
      <a class="project-card-detail inline-flex shrink-0 items-center gap-1 whitespace-nowrap" href="{{ project.detailsUrl | url }}">
        Project details <span aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>
  <p class="mb-4">{{ project.description }}</p>
  <ul class="tag-list m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Technologies used">
    {% for technology in project.technologies %}
      <li>{{ technology }}</li>
    {% endfor %}
  </ul>
</article>
