<article class="min-w-0">
  {% if project.detailsUrl %}
    <a class="block" href="{{ project.detailsUrl | url }}">
  {% endif %}
  {% if project.image %}
    <div class="{{ project.artClass }} relative mb-4 grid aspect-[3/2] place-items-center overflow-hidden">
      <img
        class="max-h-full max-w-full object-contain{% if project.imageMode == 'phone' %} shadow-[0_14px_35px_rgba(32,39,32,0.22)]{% endif %}"
        src="{{ project.image | url }}"
        alt="{{ project.imageAlt }}"
        width="{{ project.imageWidth }}"
        height="{{ project.imageHeight }}"
        loading="lazy"
      />
      <span class="absolute left-2 top-2 grid size-8 place-items-center rounded-full border border-[rgba(32,39,32,0.28)] bg-[rgba(245,243,236,0.85)] text-[10px] font-bold text-[#202720]" aria-hidden="true">{{ project.number }}</span>
    </div>
  {% else %}
    <div class="{{ project.artClass }}" aria-hidden="true"></div>
  {% endif %}
  {% if project.detailsUrl %}
    </a>
  {% endif %}
  <div class="mb-2 flex justify-between gap-2 text-[10px] font-bold tracking-[0.1em] text-muted uppercase">
    <span>{{ project.category }}</span><span>{{ project.status }}</span>
  </div>
  <div class="mb-2 flex items-baseline justify-between gap-2">
    <h3 class="m-0 min-w-0 text-xl leading-[1.6] font-semibold tracking-[-0.04em]">
      {{ project.title }}
    </h3>
    {% if project.detailsUrl %}
      <a class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap text-xs leading-[1.6] font-bold hover:text-orange" href="{{ project.detailsUrl | url }}">
        Project details <span class="text-orange" aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>
  <p class="mb-4 text-xs leading-[1.7] text-muted">{{ project.description }}</p>
  <ul class="m-0 flex list-none flex-wrap gap-2 p-0 [&>li]:rounded-full [&>li]:border [&>li]:border-line [&>li]:px-2 [&>li]:py-1 [&>li]:text-[10px] [&>li]:font-semibold [&>li]:text-tag" aria-label="Technologies used">
    {% for technology in project.technologies %}
      <li>{{ technology }}</li>
    {% endfor %}
  </ul>
</article>
