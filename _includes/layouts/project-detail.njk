---
layout: layouts/base.njk
---
{% set project = projects | findProject(projectKey) %}

<main id="content" class="page-width">
  {% set projectBackNavLabel = "Project navigation" %}
  {% include "components/project-back-nav.njk" %}

  <section class="page-section project-intro{% if project.screenshots %} has-screenshots{% endif %}" aria-labelledby="project-title">
    <h1 class="project-detail-title mb-4" id="project-title">{% include "components/project-title.njk" %}</h1>
        <p class="eyebrow mb-2 flex items-center gap-2">
    
      {{ project.category }} <span aria-hidden="true">·</span> {{ project.status }}
    </p>
    <p class="project-detail-intro mt-8">{{ project.description }}</p>
  </section>

  {% if project.screenshots %}
    <section class="project-screenshots" aria-label="{{ project.title }} screenshots">
      <div class="project-screenshot-track flex items-center gap-4 overflow-x-auto overscroll-x-contain scroll-px-2 snap-x snap-mandatory pb-2 focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4" role="group" aria-label="Swipe or scroll to browse screenshots" tabindex="0">
        {% for screenshot in project.screenshots %}
          <figure class="m-0 w-fit max-w-full shrink-0 snap-start">
            <img class="block h-auto w-auto max-h-screen max-w-full object-contain" src="{{ screenshot.src | url }}" alt="{{ screenshot.alt }}" width="{{ screenshot.width }}" height="{{ screenshot.height }}" loading="lazy" />
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <div>
    {% if project.detailSections %}
      {% for section in project.detailSections %}
        <section class="project-detail-section" aria-labelledby="{{ section.id }}">
          <div>
            <p class="eyebrow mb-2 flex items-center gap-2">{{ section.eyebrow }}</p>
            <h2 id="{{ section.id }}">{{ section.title }}</h2>
          </div>
          <div class="project-detail-copy">
            {% if section.type == "paragraphs" %}
              {% for paragraph in section.paragraphs %}
                <p class="mb-4 last:mb-0">{% if paragraph is string %}{{ paragraph }}{% else %}{{ paragraph.before }}<strong>{{ paragraph.bold }}</strong>{{ paragraph.after }}{% endif %}</p>
              {% endfor %}
            {% elif section.type == "overview" %}
              <p class="mb-4 last:mb-0">{{ project.caseStudy.overview }}</p>
            {% elif section.type == "scope" %}
              <p class="scope-note mb-4">{{ section.note }}</p>
              <div class="space-y-6">
                {% for group in section.groups %}
                <div>
                  <h3 class="scope-group-title mb-2">{{ group.title }}</h3>
                  <ul class="m-0 grid list-none grid-cols-1 gap-x-6 gap-y-2 p-0 text-body sm:grid-cols-2">
                    {% for item in group.items %}
                      <li class="flex min-w-0 items-start gap-2">
                        <span class="scope-check w-4 shrink-0" aria-hidden="true">
                          {% if item.checked %}✓{% endif %}
                        </span>
                        <span>{{ item.name }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
                {% endfor %}
              </div>
            {% elif section.type == "reflection" %}
              <p class="mb-4 last:mb-0">{{ project.caseStudy.reflection }}</p>
            {% elif section.type == "stack" %}
              <ul class="tag-list m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Technologies used">
                {% for technology in project.technologies %}
                  <li>{{ technology }}</li>
                {% endfor %}
              </ul>
            {% elif section.type == "explore" %}
              <div class="project-links mt-4 flex flex-wrap gap-4">
                {% for link in project.links %}
                  <a class="motion-reduce:transition-none" href="{{ link.url }}" target="_blank" rel="noreferrer">
                    {{ link.label }} <span aria-hidden="true">↗</span>
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </section>
      {% endfor %}
    {% else %}
    <section class="project-detail-section" aria-labelledby="overview-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">01 / Project</p>
        <h2 id="overview-title">Overview</h2>
      </div>
      <div class="project-detail-copy">
        <p class="mb-4 last:mb-0">{{ project.caseStudy.overview }}</p>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="role-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">02 / Contribution</p>
        <h2 id="role-title">Role &amp; scope</h2>
      </div>
      <div class="project-detail-copy">
        <p class="project-detail-prompt mb-4 last:mb-0">{{ project.caseStudy.role }}</p>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="highlights-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">03 / Work</p>
        <h2 id="highlights-title">Highlights</h2>
      </div>
      <div class="project-detail-copy">
        <ul class="mb-0 list-disc space-y-2 pl-5 text-body">
          {% for highlight in project.caseStudy.highlights %}
            <li>{{ highlight }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="approach-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">04 / Implementation</p>
        <h2 id="approach-title">Technical approach</h2>
      </div>
      <div class="project-detail-copy">
        <p class="project-detail-prompt mb-4 last:mb-0">{{ project.caseStudy.approach }}</p>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="learnings-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">05 / Reflection</p>
        <h2 id="learnings-title">Challenges &amp; learnings</h2>
      </div>
      <div class="project-detail-copy">
        <p class="project-detail-prompt mb-4 last:mb-0">{{ project.caseStudy.learnings }}</p>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="technologies-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">06 / Stack</p>
        <h2 id="technologies-title">Technologies</h2>
      </div>
      <div class="project-detail-copy">
        <ul class="tag-list m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Technologies used">
          {% for technology in project.technologies %}
            <li>{{ technology }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="links-title">
      <div>
        <p class="eyebrow mb-2 flex items-center gap-2">07 / Explore</p>
        <h2 id="links-title">Links</h2>
      </div>
      <div class="project-links mt-4 flex flex-wrap gap-4">
        {% for link in project.links %}
        <a class="motion-reduce:transition-none" href="{{ link.url }}" target="_blank" rel="noreferrer">
            {{ link.label }} <span aria-hidden="true">↗</span>
          </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </div>

  {% set projectBackNavLabel = "Back to project list" %}
  {% include "components/project-back-nav.njk" %}
</main>


